{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tonalia",
  "version": "0.1.0",
  "identifier": "com.tonalia.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tonalia",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../assets/soundfonts/GeneralUser-GS.sf2": "soundfonts/GeneralUser-GS.sf2",
      "../assets/soundfonts/GeneralUser-GS-LICENSE.txt": "soundfonts/GeneralUser-GS-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
